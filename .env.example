# quntbot environment template
#
# Usage:
#   1. Copy this file to .env
#   2. Fill real credentials only in .env
#   3. Never commit or share .env

TRADE_MODE=PAPER

# KIS Developers
KIS_APP_KEY=your_kis_app_key
KIS_APP_SECRET=your_kis_app_secret
KIS_ACCOUNT_NO=your_8_digit_account_number
KIS_ACCOUNT_PRODUCT_CODE=01
KIS_PAPER_BASE_URL=https://openapivts.koreainvestment.com:29443
KIS_LIVE_BASE_URL=https://openapi.koreainvestment.com:9443

# KRX Information Data System
# Required for reliable pykrx access in this project.
KRX_ID=your_krx_id
KRX_PW=your_krx_password

# OpenDART
# Get an API key from https://opendart.fss.or.kr.
# Confirm your account limits in OpenDART terms/account pages before raising these.
DART_API_KEY=your_dart_api_key
DART_REQUESTS_PER_MINUTE=60
DART_DAILY_QUOTA=10000

# Telegram notifications
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# Local paths
DATABASE_URL=sqlite:///data/quntbot.db
LOG_LEVEL=INFO

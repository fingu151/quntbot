# =============================================================================
# quntbot 환경변수 템플릿
# 사용법:
#   1. 이 파일을 .env 로 복사: copy .env.example .env
#   2. 아래 값들을 실제 키로 채우기
#   3. .env 는 절대 Git에 커밋하지 말 것 (.gitignore 처리됨)
# =============================================================================

# --- 매매 모드 (PAPER=모의투자, LIVE=실전) ---
TRADE_MODE=PAPER

# --- 한국투자증권 KIS Developers ---
# https://apiportal.koreainvestment.com 에서 발급
KIS_APP_KEY=여기에_App_Key_입력
KIS_APP_SECRET=여기에_App_Secret_입력
KIS_ACCOUNT_NO=여기에_계좌번호_8자리_입력
KIS_ACCOUNT_PRODUCT_CODE=01

# 모의투자 환경 (PAPER 모드일 때 사용)
KIS_PAPER_BASE_URL=https://openapivts.koreainvestment.com:29443
# 실전 환경 (LIVE 모드일 때 사용)
KIS_LIVE_BASE_URL=https://openapi.koreainvestment.com:9443

# --- 텔레그램 봇 (Phase 5에서 설정) ---
# BotFather (https://t.me/botfather) 에서 /newbot 으로 발급
TELEGRAM_BOT_TOKEN=여기에_봇_토큰_입력
# 본인 채팅 ID (https://t.me/userinfobot 에서 확인)
TELEGRAM_CHAT_ID=여기에_채팅_ID_입력

# --- DB 경로 ---
DATABASE_URL=sqlite:///data/quntbot.db

# --- 로그 레벨 ---
LOG_LEVEL=INFO
